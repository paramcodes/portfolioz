---

<header id="navbar" class="fixed inset-x-0 top-0 z-[76] border-b border-transparent transition-all duration-300">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8" aria-label="Main">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#d4ff4f] font-display text-lg font-bold text-black transition-transform duration-300 group-hover:rotate-12">{site.firstName[0]}</span>
      <span class="font-display text-[17px] font-semibold tracking-tight">{site.name}<span class="text-[#d4ff4f]">.</span></span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {nav.map((n) => (
        <a data-navlink href={n.href} class="rounded-full px-4 py-2 text-sm text-zinc-400 transition hover:bg-white/5 hover:text-white">{n.label}</a>
      ))}
    </div>

    <div class="hidden items-center gap-2 lg:flex">
      <button data-toggle-theme aria-label="Toggle theme" class="grid h-9 w-9 place-items-center rounded-full border border-white/10 bg-white/5 text-sm backdrop-blur transition hover:border-[#d4ff4f]/50">
        <span class="theme-icon-dark">☾</span>
        <span class="theme-icon-light hidden">☀</span>
      </button>
      <a href="#contact" class="magnetic btn-invert rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-[#d4ff4f] hover:text-black">Hire me</a>
    </div>

    <button id="menu-btn" aria-expanded="false" aria-label="Open menu" class="grid h-10 w-10 place-items-center rounded-full border border-white/10 bg-white/5 lg:hidden">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-[#07070b]/95 px-5 py-4 backdrop-blur-xl lg:hidden">
    <div class="flex flex-col gap-1">
      {nav.map((n) => (
        <a href={n.href} class="rounded-xl px-4 py-3 text-[15px] text-zinc-300 transition hover:bg-white/5 hover:text-white">{n.label}</a>
      ))}
      <div class="mt-2 flex items-center gap-3 px-4 pb-2">
        {socials.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noreferrer" class="text-zinc-500 transition hover:text-[#d4ff4f]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={icons[s.icon]} /></svg>
          </a>
        ))}
        <button data-toggle-theme class="ml-auto rounded-full border border-white/10 px-4 py-2 text-xs">Toggle theme</button>
      </div>
      <a href="#contact" class="mt-1 rounded-xl bg-[#d4ff4f] px-4 py-3 text-center font-semibold text-black">Hire me</a>
    </div>
  </div>
</header>
