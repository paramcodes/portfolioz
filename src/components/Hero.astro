---
import { site, stats } from '../config';
---

<section id="top" class="relative overflow-hidden pt-16">
  <!-- aurora background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="animate-aurora absolute -top-40 left-1/2 h-[560px] w-[900px] -translate-x-1/2 rounded-full opacity-70 blur-3xl" style="background: radial-gradient(closest-side, rgba(139,92,246,.35), transparent), radial-gradient(closest-side, rgba(212,255,79,.14), transparent);"></div>
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 30%, transparent 75%);"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-5 pb-14 pt-14 sm:px-8 sm:pt-20">
    <div class="reveal flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 font-mono text-xs tracking-widest text-zinc-300 backdrop-blur">
        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#d4ff4f] opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-[#d4ff4f]"></span></span>
        {site.availability}
      </span>
      <span class="hidden items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 font-mono text-xs tracking-widest text-zinc-400 sm:inline-flex">
        ◷ <span id="local-time">--:--</span> IST · {site.location}
      </span>
    </div>

    <h1 class="reveal mt-7 font-display text-[13vw] font-bold leading-[0.95] tracking-[-0.04em] sm:text-7xl lg:text-[6.2rem]" style="--reveal-delay:80ms">
      {site.firstName}<span class="text-[#d4ff4f]">.</span> builds
      <span class="block bg-gradient-to-r from-violet-400 via-fuchsia-300 to-[#d4ff4f] bg-clip-text text-transparent">AI systems & backends</span>
      <span class="block">that <span class="italic font-medium">ship</span><span class="text-stroke">.</span></span>
    </h1>

    <div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <p class="reveal max-w-xl text-lg leading-relaxed text-zinc-400" style="--reveal-delay:160ms">
        {site.tagline} GSSoC ’24 maintainer · <strong class="text-zinc-100">500+ DSA problems</strong> solved · RAG pipelines, LLM agents & cloud infra in production.
      </p>
      <div class="reveal flex flex-wrap items-center gap-3" style="--reveal-delay:220ms">
        <a href="#work" class="magnetic btn-primary rounded-full bg-[#d4ff4f] px-7 py-3.5 font-semibold text-black transition hover:brightness-110">View my work →</a>
        <a href={site.resumeUrl} target="_blank" rel="noopener" class="magnetic rounded-full border border-white/15 bg-white/5 px-7 py-3.5 font-semibold text-white backdrop-blur transition hover:border-white/40 hover:bg-white/10">↓ Résumé</a>
      </div>
    </div>

    <!-- stats -->
    <dl class="reveal dark-isle mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 lg:grid-cols-4" style="--reveal-delay:280ms">
      {stats.map((s) => (
        <div class="bg-[#0d0d14]/95 p-6 backdrop-blur transition hover:bg-[#13131d]">
          <dt class="order-2 mt-1 text-sm text-zinc-500">{s.label}</dt>
          <dd class="font-display text-4xl font-bold tracking-tight"><span data-count={s.value}>0</span><span class="text-[#d4ff4f]">{s.suffix}</span></dd>
        </div>
      ))}
    </dl>

    <!-- hero cards -->
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <a href="https://github.com/paramcodes/rag-agent-api" target="_blank" rel="noopener" class="reveal spotlight tilt group rounded-2xl border border-white/10 bg-gradient-to-br from-violet-600/25 to-transparent p-6 transition hover:border-violet-400/40" style="--reveal-delay:320ms">
        <div class="font-display text-5xl">◈</div>
        <h3 class="mt-4 font-display text-lg font-semibold">ATLAS RAG API</h3>
        <p class="mt-1 text-sm text-zinc-400">RAPTOR indexing · RRF fusion · live on GitHub</p>
        <span class="mt-4 inline-block text-sm text-[#d4ff4f] transition group-hover:translate-x-1">Explore →</span>
      </a>
      <div class="reveal spotlight rounded-2xl border border-white/10 bg-white/[0.03] p-6 backdrop-blur" style="--reveal-delay:380ms">
        <p class="font-mono text-xs tracking-widest text-zinc-500">CURRENTLY INTO</p>
        <p class="mt-3 leading-relaxed text-zinc-300">Agentic pipelines, RAPTOR retrieval & distributed inference. Building in public on GitHub.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {['RAG + RRF', 'pgvector', 'AWS'].map((t) => <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-300">{t}</span>)}
        </div>
      </div>
      <a href="https://github.com/paramcodes" target="_blank" rel="noopener" class="reveal spotlight tilt group rounded-2xl border border-white/10 bg-gradient-to-br from-[#d4ff4f]/15 to-transparent p-6 transition hover:border-[#d4ff4f]/40" style="--reveal-delay:440ms">
        <div class="font-display text-5xl text-[#d4ff4f]">✦</div>
        <p class="mt-3 text-[15px] leading-relaxed text-zinc-300">“Led 50+ contributors as a GSSoC ’24 project admin — 50+ PRs merged, zero-downtime deploys.”</p>
        <p class="mt-4 font-mono text-xs tracking-widest text-zinc-500">OPEN SOURCE · 70 REPOS</p>
      </a>
    </div>
  </div>
</section>
