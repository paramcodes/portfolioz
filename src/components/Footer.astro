---

<footer class="border-t border-white/10 bg-black/40">
  <!-- big CTA banner -->
  <div class="mx-auto max-w-7xl px-5 pt-16 sm:px-8">
    <a href="#contact" class="reveal group block overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-r from-violet-600/30 via-fuchsia-500/10 to-[#d4ff4f]/15 p-8 transition hover:border-[#d4ff4f]/40 sm:p-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="font-mono text-xs tracking-[0.25em] text-[#d4ff4f]">HAVE A ROLE OR A PROJECT?</div>
          <div class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-5xl">Let's build something real <span class="inline-block transition group-hover:translate-x-2 group-hover:-rotate-12">↗</span></div>
        </div>
        <div class="magnetic grid h-20 w-20 shrink-0 place-items-center rounded-full bg-[#d4ff4f] font-display text-3xl text-black transition group-hover:scale-110">→</div>
      </div>
    </a>
  </div>

  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.2fr_.8fr_.8fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#d4ff4f] font-display text-lg font-bold text-black">{site.firstName[0]}</span>
        <span class="font-display text-lg font-semibold">{site.name}<span class="text-[#d4ff4f]">.</span></span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-zinc-500">{site.tagline}</p>
      <div class="mt-5 flex gap-2">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer" aria-label={s.label} class="grid h-10 w-10 place-items-center rounded-full border border-white/10 bg-white/5 text-zinc-400 transition hover:border-[#d4ff4f]/50 hover:text-[#d4ff4f]">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d={icons[s.icon]} /></svg>
          </a>
        ))}
      </div>
    </div>
    <nav aria-label="Sitemap">
      <div class="font-mono text-xs tracking-widest text-zinc-500">SITEMAP</div>
      <ul class="mt-4 space-y-2.5 text-sm">
        {nav.map((n) => <li><a href={n.href} class="text-zinc-400 transition hover:text-[#d4ff4f]">{n.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <div class="font-mono text-xs tracking-widest text-zinc-500">GET IN TOUCH</div>
      <a href={`mailto:${site.email}`} class="mt-4 block text-sm text-zinc-300 transition hover:text-[#d4ff4f] break-all">{site.email}</a>
      <a href={`tel:${site.phone}`} class="mt-1 block text-sm text-zinc-400 transition hover:text-[#d4ff4f]">{site.phoneDisplay}</a>
      <div class="mt-1 text-sm text-zinc-500">{site.location}</div>
      <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-[#d4ff4f]/30 bg-[#d4ff4f]/5 px-4 py-2 font-mono text-xs text-[#d4ff4f]">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d4ff4f]"></span> {site.availability}
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-5 py-6 font-mono text-xs text-zinc-600 sm:flex-row sm:px-8">
      <span>© <span id="year">2026</span> {site.name} · Built with Astro & Tailwind</span>
      <a href="#top" class="transition hover:text-[#d4ff4f]">Back to top ↑</a>
    </div>
  </div>
</footer>
