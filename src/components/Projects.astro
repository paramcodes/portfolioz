---
import { projects } from '../config';

const categories = ['all', ...Array.from(new Set(projects.map((p) => p.category)))];
const spanClass: Record<string, string> = {
  wide: 'sm:col-span-2',
  tall: 'sm:row-span-2',
  normal: '',
};
---

<section id="work" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-24 sm:px-8">
  <div class="reveal flex items-center gap-3 font-mono text-xs tracking-[0.25em] text-[#d4ff4f]">
    <span class="h-px w-10 bg-[#d4ff4f]/60"></span> 03 · SELECTED WORK
  </div>
  <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <h2 class="reveal max-w-2xl font-display text-4xl font-bold tracking-tight sm:text-6xl">Systems I've <span class="italic text-zinc-400">designed, built</span> & shipped.</h2>
    <div class="reveal flex flex-wrap gap-2">
      {categories.map((c, i) => (
        <button
          data-filter={c}
          class={`rounded-full border border-white/10 px-4 py-2 text-[13px] font-medium transition hover:border-[#d4ff4f]/50 ${i === 0 ? 'bg-[#d4ff4f] text-black border-transparent' : 'text-zinc-400'}`}
        >{c === 'all' ? 'All' : c}</button>
      ))}
    </div>
  </div>

  <div class="mt-10 grid auto-rows-[minmax(0,1fr)] gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p, i) => (
      <article
        data-category={p.category}
        class={`reveal spotlight tilt group relative flex min-h-[320px] flex-col justify-end overflow-hidden rounded-3xl border border-white/10 transition hover:-translate-y-1 hover:border-white/25 ${spanClass[p.span ?? 'normal']}`}
        style={`--reveal-delay:${(i % 3) * 80}ms`}
      >
        <div class={`absolute inset-0 bg-gradient-to-br ${p.gradient} opacity-60 transition duration-500 group-hover:scale-105 group-hover:opacity-80`} aria-hidden="true"></div>
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,.88) 20%, rgba(0,0,0,.3) 60%, transparent);" aria-hidden="true"></div>
        <div class="absolute right-5 top-5 font-display text-6xl text-white/25 transition group-hover:scale-125 group-hover:text-white/50">{p.emoji}</div>
        {p.featured && <span class="absolute left-5 top-5 rounded-full bg-[#d4ff4f] px-3 py-1 font-mono text-[11px] font-bold tracking-widest text-black">FEATURED</span>}
        <div class="relative p-6">
          <div class="flex items-center gap-2 font-mono text-[11px] tracking-widest text-white/70">
            <span>{p.category.toUpperCase()}</span><span>·</span><span>{p.year}</span>
          </div>
          <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">{p.title}</h3>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-white/75">{p.description}</p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {p.tags.map((t) => <span class="rounded-full border border-white/20 bg-black/30 px-3 py-1 text-xs backdrop-blur">{t}</span>)}
          </div>
          <div class="mt-4 flex items-center gap-2 border-t border-white/15 pt-4">
            <a href={p.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-white px-4 py-2 text-xs font-semibold text-black transition hover:bg-[#d4ff4f]">⌥ Code ↗</a>
            {p.demo && <a href={p.demo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-white/25 bg-black/30 px-4 py-2 text-xs font-semibold text-white backdrop-blur transition hover:border-[#d4ff4f] hover:text-[#d4ff4f]">● Live demo ↗</a>}
          </div>
        </div>
      </article>
    ))}
  </div>

  <p class="reveal mt-8 text-center text-sm text-zinc-500">70+ repos and counting — <a href="https://github.com/paramcodes" target="_blank" rel="noopener" class="text-[#d4ff4f] underline-offset-4 hover:underline">explore the full archive on GitHub →</a></p>
</section>
