---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page not found">
  <main class="grid min-h-screen place-items-center px-6">
    <div class="text-center">
      <div class="font-display text-[8rem] font-bold leading-none tracking-tight"><span class="text-stroke">404</span></div>
      <h1 class="mt-4 font-display text-2xl font-semibold">Lost in space?</h1>
      <p class="mt-2 text-zinc-500">This page drifted off the map. Let's get you home.</p>
      <a href="/" class="mt-8 inline-block rounded-full bg-[#d4ff4f] px-7 py-3.5 font-semibold text-black transition hover:brightness-110">← Back home</a>
    </div>
  </main>
</Base>
