---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import oss from '../data/oss.json';

const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

// pad last week to 7 cells for grid alignment
const weeks = oss.weeks.map((w) => [...w, ...Array(Math.max(0, 7 - w.length)).fill(null)]);

// month labels: first column where a new month appears (spaced ≥3 cols apart)
let lastMonth = -1;
let lastLabelCol = -10;
const labels = weeks.map((week, ci) => {
  const day = week.find((d) => d);
  if (!day) return null;
  const m = +day.date.slice(5, 7);
  if (m !== lastMonth && ci - lastLabelCol > 2) {
    lastMonth = m;
    lastLabelCol = ci;
    return monthNames[m - 1];
  }
  return null;
});

const maxRepo = Math.max(1, ...oss.topRepos.map((r) => r.count));
const badge: Record<string, string> = {
  merged: 'bg-[#d4ff4f] text-black',
  open: 'bg-emerald-500 text-white',
  closed: 'bg-white/5 text-zinc-400 border border-white/10',
};
const updated = oss.updatedAt.slice(0, 10);
---

<Base title="OSS — Paramveer Singh" description="Open-source contributions: contribution graph, merged pull requests and upstream work.">
  <Navbar />
  <main id="top" class="relative overflow-hidden pt-16">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -top-40 left-1/2 h-[420px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl" style="background: radial-gradient(closest-side, rgba(139,92,246,.3), transparent), radial-gradient(closest-side, rgba(212,255,79,.12), transparent);"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 pb-24 pt-14 sm:px-8">
      <div class="reveal flex items-center gap-3 font-mono text-xs tracking-[0.25em] text-[#d4ff4f]">
        <span class="h-px w-10 bg-[#d4ff4f]/60"></span> OPEN SOURCE
      </div>
      <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="reveal max-w-3xl font-display text-5xl font-bold tracking-tight sm:text-6xl">Code in the <span class="bg-gradient-to-r from-violet-400 to-[#d4ff4f] bg-clip-text text-transparent">open.</span></h1>
          <p class="reveal mt-4 max-w-xl text-zinc-400">Live contribution graph and pull-request feed, synced from GitHub on every build. <span class="font-mono text-xs">Updated {updated}{oss.stale ? ' · cached (API limit hit)' : ''}</span></p>
        </div>
        <a href="https://github.com/paramcodes" target="_blank" rel="noopener" class="reveal magnetic inline-flex w-fit items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-black transition hover:bg-[#d4ff4f] btn-invert hover:text-black">GitHub profile ↗</a>
      </div>

      <!-- stats -->
      <dl class="reveal dark-isle mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 lg:grid-cols-4">
        {[
          [oss.totalContributions, '', 'Contributions · last year'],
          [oss.currentStreak, oss.currentStreak === 1 ? ' day' : ' days', 'Current streak'],
          [oss.longestStreak, oss.longestStreak === 1 ? ' day' : ' days', 'Longest streak'],
          [oss.stats.prsMerged, '', 'PRs merged upstream'],
        ].map(([v, suffix, label]) => (
          <div class="bg-[#0d0d14]/95 p-6 backdrop-blur transition hover:bg-[#13131d] dark-isle">
            <dt class="order-2 mt-1 text-sm text-zinc-500">{label}</dt>
            <dd class="font-display text-4xl font-bold tracking-tight"><span data-count={v}>0</span><span class="text-[#d4ff4f]">{suffix}</span></dd>
          </div>
        ))}
      </dl>

      <!-- heatmap -->
      <section class="reveal spotlight mt-6 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8" aria-label="Contribution graph">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-display text-lg font-semibold">{oss.totalContributions} contributions in the last year</h2>
          <div class="flex items-center gap-1.5 font-mono text-[11px] text-zinc-500">
            Less
            {[0,1,2,3,4].map((l) => <span class="cal-cell" data-level={l}></span>)}
            More
          </div>
        </div>
        <div class="mt-5 overflow-x-auto pb-2">
          <div class="w-max">
            <div class="flex gap-[3px]" aria-hidden="true">
              {labels.map((m) => <span class="w-[11px] flex-none font-mono text-[9px] text-zinc-500">{m ?? ''}</span>)}
            </div>
            <div class="mt-1 flex gap-[3px]" role="img" aria-label={`${oss.totalContributions} contributions in the last year`}>
              {weeks.map((week) => (
                <div class="flex flex-col gap-[3px]">
                  {week.map((d) => d
                    ? <span class="cal-cell" data-level={d.level} title={`${d.count} contribution${d.count === 1 ? '' : 's'} on ${d.date}`}></span>
                    : <span class="cal-cell empty"></span>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <div class="mt-6 grid gap-4 lg:grid-cols-[380px_1fr]">
        <!-- top repos -->
        <section class="reveal rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-7">
          <h2 class="font-display text-lg font-semibold">Top PR repositories</h2>
          <ul class="mt-5 space-y-4">
            {oss.topRepos.map((r) => (
              <li>
                <div class="flex items-baseline justify-between gap-2">
                  <a href={`https://github.com/${r.repo}`} target="_blank" rel="noopener" class="truncate text-sm font-semibold transition hover:text-[#d4ff4f]">{r.repo}</a>
                  <span class="flex-none font-mono text-xs text-zinc-500">★ {r.stars.toLocaleString()} · {r.count} PR{r.count === 1 ? '' : 's'}</span>
                </div>
                <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-zinc-500/20">
                  <div class="h-full rounded-full bg-gradient-to-r from-violet-500 to-[#d4ff4f]" style={`width:${Math.round((r.count / maxRepo) * 100)}%`}></div>
                </div>
              </li>
            ))}
          </ul>
          <div class="mt-6 rounded-2xl border border-[#d4ff4f]/20 bg-[#d4ff4f]/5 p-4 text-sm leading-relaxed text-zinc-300">
            <span class="font-semibold text-[#d4ff4f]">Maintainer —</span> GSSoC ’24 project admin: led 50+ contributors, merged 50+ PRs at zero downtime.
          </div>
        </section>

        <!-- PR feed -->
        <section class="reveal rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-7">
          <div class="flex items-center justify-between">
            <h2 class="font-display text-lg font-semibold">Pull requests</h2>
            <span class="font-mono text-xs text-zinc-500">{oss.stats.prsTotal} total · {oss.stats.prsOpen} open</span>
          </div>
          <ul class="mt-4 divide-y divide-white/10">
            {oss.prs.map((p) => (
              <li class="py-4 first:pt-1 last:pb-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`rounded-full px-2.5 py-0.5 font-mono text-[11px] font-bold ${badge[p.state]}`}>● {p.state}</span>
                  <a href={p.url} target="_blank" rel="noopener" class="font-medium leading-snug transition hover:text-[#d4ff4f]">{p.title}</a>
                </div>
                <div class="mt-1.5 font-mono text-xs text-zinc-500">
                  <a href={`https://github.com/${p.repo}`} target="_blank" rel="noopener" class="transition hover:text-[#d4ff4f]">{p.repo}</a>
                  <span> ★ {p.stars.toLocaleString()} · #{p.number} · {p.date}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>
