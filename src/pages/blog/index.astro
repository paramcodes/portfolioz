---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { BLOG_POSTS } from '../../data/blog';

const [featured, ...rest] = BLOG_POSTS;
---

<Base title={`Blog — Paramveer Singh`} description="Notes on AI systems, RAG pipelines, distributed backends and Git internals.">
  <Navbar />
  <main id="top" class="relative overflow-hidden pt-16">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -top-40 left-1/2 h-[420px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl" style="background: radial-gradient(closest-side, rgba(139,92,246,.3), transparent), radial-gradient(closest-side, rgba(212,255,79,.12), transparent);"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 pb-24 pt-14 sm:px-8">
      <div class="reveal flex items-center gap-3 font-mono text-xs tracking-[0.25em] text-[#d4ff4f]">
        <span class="h-px w-10 bg-[#d4ff4f]/60"></span> BLOG
      </div>
      <h1 class="reveal mt-4 max-w-3xl font-display text-5xl font-bold tracking-tight sm:text-6xl">Notes from the <span class="bg-gradient-to-r from-violet-400 to-[#d4ff4f] bg-clip-text text-transparent">build log.</span></h1>
      <p class="reveal mt-4 max-w-xl text-zinc-400">Long-form write-ups on agents, retrieval, distributed systems and tooling — migrated from my previous portfolio, unedited.</p>

      <!-- featured -->
      <a href={`/blog/${featured.slug}`} class="reveal spotlight tilt group mt-10 grid overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] transition hover:border-[#d4ff4f]/40 lg:grid-cols-2">
        <div class="bg-gradient-to-br from-violet-600/40 via-fuchsia-500/20 to-transparent p-8 sm:p-12">
          <div class="flex items-center gap-3 font-mono text-xs tracking-widest text-[#d4ff4f]">
            <span class="rounded-full bg-[#d4ff4f] px-3 py-1 font-bold text-black">FEATURED</span>
            <span class="text-zinc-400">{featured.date} · {featured.readTime}</span>
          </div>
          <h2 class="mt-4 font-display text-3xl font-bold tracking-tight transition group-hover:text-[#d4ff4f] sm:text-4xl">{featured.title}</h2>
          <p class="mt-3 leading-relaxed text-zinc-400">{featured.blurb}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {featured.tags.map((t) => <span class="rounded-full border border-white/10 bg-black/30 px-3 py-1 text-xs text-zinc-300">{t}</span>)}
          </div>
          <span class="mt-6 inline-block font-semibold text-[#d4ff4f]">Read →</span>
        </div>
        <div class="grid place-items-center border-t border-white/10 bg-black/30 p-12 font-display text-8xl text-white/10 transition group-hover:text-[#d4ff4f]/30 dark-isle lg:border-l lg:border-t-0">◈</div>
      </a>

      <!-- grid -->
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((p, i) => (
          <a href={`/blog/${p.slug}`} class="reveal spotlight tilt group flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-7 transition hover:-translate-y-1 hover:border-[#d4ff4f]/40" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <div class="flex items-center justify-between font-mono text-[11px] tracking-widest text-zinc-500">
              <span>{p.date}</span><span class="text-[#d4ff4f]">{p.readTime.toUpperCase()}</span>
            </div>
            <h2 class="mt-3 font-display text-xl font-bold tracking-tight transition group-hover:text-[#d4ff4f]">{p.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{p.blurb}</p>
            <div class="mt-4 flex flex-wrap gap-1.5 border-t border-white/10 pt-4">
              {p.tags.slice(0, 3).map((t) => <span class="rounded-full bg-white/5 px-2.5 py-1 text-[11px] text-zinc-400">{t}</span>)}
              <span class="ml-auto text-sm text-zinc-500 transition group-hover:translate-x-1 group-hover:text-[#d4ff4f]">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Base>
